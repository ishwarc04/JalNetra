# JalNetra 2.0 Backend Environment Configuration
APP_NAME=JalNetra API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Database & Storage
DATABASE_URL=sqlite:///./data/database/jalnetra.db
DATA_DIR=./data

# CORS / Frontend origin
FRONTEND_URL=http://localhost:5173

# Water Body Discovery (Phase 2)
WATERBODY_DISCOVERY_ENABLED=true
WATERBODY_DISCOVERY_PROVIDER=osm
WATERBODY_DISCOVERY_TIMEOUT_SECONDS=15.0
WATERBODY_DISCOVERY_CACHE_TTL_SECONDS=86400
WATERBODY_DISCOVERY_USER_AGENT=JalNetra/2.0 (Geospatial Water Resource Monitoring; contact@jalnetra.local)

# Sentinel-2 Satellite Acquisition (Phase 3)
# Uses public AWS Earth Search STAC catalog without AWS credentials
SATELLITE_PROVIDER=earth_search
SATELLITE_STAC_URL=https://earth-search.aws.element84.com/v1
SATELLITE_COLLECTION=sentinel-2-c1-l2a
SATELLITE_REQUEST_TIMEOUT_SECONDS=60.0
SATELLITE_CACHE_TTL_SECONDS=86400

# AI Assistant (OpenAI)
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=800

# Telegram Bot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=jalNetra_Helperbot
TELEGRAM_ALLOWED_CHAT_IDS=

# Weather Integration (Phase 6 preparation)
WEATHER_API_KEY=
WEATHER_PROVIDER=
